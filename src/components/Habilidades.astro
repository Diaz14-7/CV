<section id="habilidades">
  <h2>HABILIDADES</h2>

  <div class="cuadricula">
    <div class="tarjeta">
      <img src="/java.png" alt="Java" />
      <p>Java</p>
    </div>

    <div class="tarjeta">
      <img src="/html.png" alt="HTML" />
      <p>HTML</p>
    </div>

    <div class="tarjeta">
      <img src="/css.png" alt="CSS" />
      <p>CSS</p>
    </div>

    <div class="tarjeta">
      <img src="/mysql.png" alt="MySQL" />
      <p>MySQL</p>
    </div>

    <div class="tarjeta">
      <img src="/spring.png" alt="Spring" />
      <p>Spring</p>
    </div>

    <div class="tarjeta">
      <img src="/javascript.png" alt="JavaScript" />
      <p>JavaScript</p>
    </div>

    <div class="tarjeta">
      <img src="/angular.png" alt="Angular" />
      <p>Angular</p>
    </div>

    <div class="tarjeta">
      <img src="/ingles.png" alt="Inglés" />
      <p>Inglés</p>
    </div>
  </div>
</section>

<style>
  section {
    max-width: 1100px;
    margin: 0 auto;
    min-height: calc(100vh - 56px);
    padding: 2rem 5rem 4rem 5rem;
    box-sizing: border-box;
    scroll-margin-top: 56px;
  }

  h2 {
    margin: 0 0 3rem 0;
    font-size: 1.9rem;
    font-weight: 500;
  }

  .cuadricula {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
  }

  .tarjeta {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    aspect-ratio: 1.1;
    padding: 1.2rem 0.5rem 0.9rem 0.5rem;
    box-sizing: border-box;
    background: #1f1f1f;
    border-radius: 4px;
  }

  .tarjeta img {
    height: 72%;
    width: auto;
    max-width: 85%;
    object-fit: contain;
    display: block;
  }

  .tarjeta p {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: white;
  }

  @media (max-width: 700px) {
    section {
      padding: 1.5rem 1.5rem 3rem 1.5rem;
    }

    h2 {
      font-size: 1.5rem;
    }

    .cuadricula {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
