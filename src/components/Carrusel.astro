<section class="carrusel">
  <a class="tarjeta" href="#sobre-mi">
    <img src="/public/SobreMi.png" alt="Sobre mí" />
  </a>

  <a class="tarjeta" href="#habilidades">
    <img src="/public/Habilidades.png" alt="Habilidades" />
  </a>

  <a class="tarjeta" href="#formacion">
    <img src="/public/Formacion.png" alt="Formación" />
  </a>

  <a class="tarjeta" href="#experiencia">
    <img src="/public/Experiencia.png" alt="Experiencia" />
  </a>

  <a class="tarjeta" href="#contacto">
    <img src="/public/Contacto.png" alt="Contacto" />
  </a>
</section>

<style>
  .carrusel {
    display: flex;
    gap: 6%;
    padding: 4rem 14%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .carrusel::-webkit-scrollbar {
    display: none;
  }

  .tarjeta {
    flex: 0 0 72%;
    aspect-ratio: 1.57;
    border-radius: 16px;
    overflow: hidden;
    scroll-snap-align: center;
    box-shadow:
      0 0 18px 4px rgba(255, 30, 30, 0.55),
      0 0 55px 12px rgba(160, 0, 0, 0.35);
    animation: led 3s ease-in-out infinite;
    transition: transform 0.3s ease;
  }

  .tarjeta:hover {
    transform: scale(1.015);
  }

  .tarjeta img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @keyframes led {
    0%,
    100% {
      box-shadow:
        0 0 18px 4px rgba(255, 30, 30, 0.55),
        0 0 55px 12px rgba(160, 0, 0, 0.35);
    }
    50% {
      box-shadow:
        0 0 26px 7px rgba(255, 30, 30, 0.8),
        0 0 75px 18px rgba(160, 0, 0, 0.5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tarjeta {
      animation: none;
    }
  }
</style>
