---
import Layout from "../layouts/Layout.astro";
import Cabecera from "../components/Cabecera.astro";
import Carrusel from "../components/Carrusel.astro";
import Habilidades from "../components/Habilidades.astro";
---

<Layout>
  <Cabecera />

  <main id="inicio">
    <Carrusel />

    <section id="sobre-mi" class="pendiente">
      <h2>SOBRE MÍ</h2>
    </section>

    <Habilidades />

    <section id="formacion" class="pendiente">
      <h2>FORMACIÓN</h2>
    </section>

    <section id="experiencia" class="pendiente">
      <h2>EXPERIENCIA</h2>
    </section>

    <section id="contacto" class="pendiente">
      <h2>CONTACTO</h2>
    </section>
  </main>
</Layout>

<style>
  main {
    padding-top: 70px;
  }

  .pendiente {
    min-height: calc(100vh - 56px);
    padding: 4rem 5rem;
    box-sizing: border-box;
    scroll-margin-top: 70px;
  }

  .pendiente h2 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 500;
  }
</style>
