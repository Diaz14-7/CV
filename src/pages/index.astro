---
import Layout from "../layouts/Layout.astro";
import Cabecera from "../components/Cabecera.astro";
import Carrusel from "../components/Carrusel.astro";
import SobreMi from "../components/SobreMi.astro";
import Habilidades from "../components/Habilidades.astro";
import Formacion from "../components/Formacion.astro";
import Experiencia from "../components/Experiencia.astro";
---

<Layout>
  <Cabecera />

  <main id="inicio">
    <Carrusel />

    <SobreMi />

    <Habilidades />

    <Formacion />

    <Experiencia />

    <section id="contacto" class="pendiente">
      <h2>CONTACTO</h2>
    </section>
  </main>
</Layout>

<style>
  main {
    padding-top: 70px;
  }

  .pendiente {
    min-height: calc(100vh - 56px);
    padding: 4rem 5rem;
    box-sizing: border-box;
    scroll-margin-top: 70px;
  }

  .pendiente h2 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 500;
  }
</style>
